# plugins/Skript/scripts/discord-commands.sk 로 복사하세요.
# Skript와 MingyeolDiscordApi 플러그인이 설치되어 있어야 합니다.

command /연동 [<text>]:
    permission: discordskript.link
    permission message: &c연동 권한이 없습니다.
    trigger:
        if arg-1 is set:
            discord_link player with arg-1
        else:
            discord_link player

command /discord_setname <player> <text>:
    permission: discordskript.admin
    permission message: &c관리자 전용 명령입니다.
    trigger:
        discord_setname arg-1 to arg-2

command /discord_mute <player> <text>:
    permission: discordskript.admin
    permission message: &c관리자 전용 명령입니다.
    trigger:
        if arg-2 is "차단":
            discord_mute arg-1
        else if arg-2 is "허용":
            discord_unmute arg-1
        else:
            send "&c사용법: /discord_mute <플레이어> <차단|허용>" to sender
